# Backend environment variables (copy this to .env and fill in values)

# REQUIRED for cloud hosting - PostgreSQL connection string from Supabase/Neon/Railway
# Get this from your database provider's dashboard
DATABASE_URL=postgresql://user:password@host:5432/dbname

# REQUIRED - Use a long random string (generate: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-super-secret-key-here

# Your deployed frontend URL (comma-separated if multiple)
ALLOWED_ORIGINS=https://your-app.vercel.app

# Admin credentials (change these!)
ADMIN_USER=admin
ADMIN_PASS=admin123
